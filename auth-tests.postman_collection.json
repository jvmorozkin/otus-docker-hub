    {
      "name": "8.1 Попытка доступа пользователя 2 к профилю пользователя 1 по ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user2Token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/profile/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "profile", "1"]
        }
      },
      "response": []
    },
    {
      "name": "8.2 Проверка что пользователь2 получает свой профиль",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Проверяем что пользователь2 получает СВОЙ профиль, а не пользователя1",
              "if (pm.response.code === 200) {",
              "    const profile = pm.response.json();",
              "    ",
              "    // Должен вернуться профиль пользователя2, а не пользователя1",
              "    if (profile.username === pm.variables.get('user2Username')) {",
              "        console.log('User2 correctly received his own profile');",
              "    } else {",
              "        console.error('User2 received wrong profile:', profile.username);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user2Token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "profile"]
        }
      },
      "response": []
