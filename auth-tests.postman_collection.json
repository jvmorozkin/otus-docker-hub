{
  "info": {
    "name": "OTUS Auth Tests",
    "description": "Тесты аутентификации и профиля пользователя с исправленным извлечением токена",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework",
      "type": "string"
    },
    {
      "key": "user1Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user2Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user1Username",
      "value": "",
      "type": "string"
    },
    {
      "key": "user1Password",
      "value": "",
      "type": "string"
    },
    {
      "key": "user2Username",
      "value": "",
      "type": "string"
    },
    {
      "key": "user2Password",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0.1 Health Check (без токена)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "1. Регистрация пользователя 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomSuffix = Math.floor(Math.random() * 10000);",
              "const username = 'user1_' + randomSuffix;",
              "const password = 'password' + randomSuffix;",
              "",
              "pm.variables.set('user1Username', username);",
              "pm.variables.set('user1Password', password);",
              "",
              "console.log('Generated user1:', username, password);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Извлекаем токен из ответа регистрации",
              "if (pm.response.code === 200) {",
              "    const responseData = pm.response.json();",
              "    const token = responseData.token;",
              "    ",
              "    if (token && token.length > 10) {",
              "        pm.variables.set('user1Token', token);",
              "        console.log('User1 token saved from registration:', token);",
              "        console.log('Token length:', token.length);",
              "    } else {",
              "        console.error('Invalid token received from registration:', token);",
              "    }",
              "} else {",
              "    console.error('Registration failed:', pm.response.code, pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user1Username}}\",\n  \"password\": \"{{user1Password}}\",\n  \"email\": \"{{user1Username}}@example.com\",\n  \"firstName\": \"User1FirstName\",\n  \"lastName\": \"User1LastName\",\n  \"phone\": \"+79161234567\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "2. Проверка доступа без токена",
      "item": [
        {
          "name": "Получение профиля без токена",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "Изменение профиля без токена",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"NewFirstName\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profile"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Вход пользователя 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Извлекаем токен из ответа логина (если не получили при регистрации)",
              "if (pm.response.code === 200) {",
              "    const responseData = pm.response.json();",
              "    const token = responseData.token;",
              "    ",
              "    if (token && token.length > 10) {",
              "        pm.variables.set('user1Token', token);",
              "        console.log('User1 token saved from login:', token);",
              "        console.log('Token length:', token.length);",
              "    } else {",
              "        console.error('Invalid token received from login:', token);",
              "    }",
              "} else {",
              "    console.error('Login failed:', pm.response.code, pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user1Username}}\",\n  \"password\": \"{{user1Password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "3.1 Проверка токена",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/check-token",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "check-token"]
        }
      },
      "response": []
    },
    {
      "name": "4. Изменение профиля пользователя 1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"UpdatedFirstName\",\n  \"lastName\": \"UpdatedLastName\",\n  \"phone\": \"+79169876543\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "profile"]
        }
      },
      "response": []
    },
    {
      "name": "5. Проверка изменений профиля",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1Token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "profile"]
        }
      },
      "response": []
    },
    {
      "name": "6. Регистрация пользователя 2",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomSuffix = Math.floor(Math.random() * 10000) + 10000;",
              "const username = 'user2_' + randomSuffix;",
              "const password = 'password' + randomSuffix;",
              "",
              "pm.variables.set('user2Username', username);",
              "pm.variables.set('user2Password', password);",
              "",
              "console.log('Generated user2:', username, password);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Извлекаем токен из ответа регистрации пользователя 2",
              "if (pm.response.code === 200) {",
              "    const responseData = pm.response.json();",
              "    const token = responseData.token;",
              "    ",
              "    if (token && token.length > 10) {",
              "        pm.variables.set('user2Token', token);",
              "        console.log('User2 token saved from registration:', token);",
              "    } else {",
              "        console.error('Invalid token received for user2:', token);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user2Username}}\",\n  \"password\": \"{{user2Password}}\",\n  \"email\": \"{{user2Username}}@example.com\",\n  \"firstName\": \"User2FirstName\",\n  \"lastName\": \"User2LastName\",\n  \"phone\": \"+79161111111\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "7. Вход пользователя 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Извлекаем токен из ответа логина пользователя 2 (если не получили при регистрации)",
              "if (pm.response.code === 200) {",
              "    const responseData = pm.response.json();",
              "    const token = responseData.token;",
              "    ",
              "    if (token && token.length > 10) {",
              "        pm.variables.set('user2Token', token);",
              "        console.log('User2 token saved from login:', token);",
              "    } else {",
              "        console.error('Invalid token received for user2 login:', token);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user2Username}}\",\n  \"password\": \"{{user2Password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "8. Проверка доступа пользователя 2 к профилю пользователя 1",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user2Token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "profile"]
        }
      },
